{
  "name": "coreball-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "CoreBall - a free Coreball / まち針ゲーム style browser game. SEO-first static site built with Vite.",
  "scripts": {
    "gen": "node scripts/generate-levels.mjs && node scripts/simulate-collisions.mjs && node scripts/generate-assets.mjs && node scripts/generate-pages.mjs",
    "test:game": "node scripts/generate-levels.mjs && node scripts/simulate-collisions.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:visual": "node scripts/browser-visual.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build",
    "postbuild": "node scripts/verify-dist.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
